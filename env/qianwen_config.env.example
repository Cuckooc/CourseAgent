# 通义千问 DashScope 配置（复制为 qianwen_config.env 并填入真实值）
model=qwen-plus
api_key=your_dashscope_api_key
base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
Temperature=0.9
similarity_threshold=0.8
MAX_ITERATIONS=10
VERBOSE=True
# LLM 网关：单次请求超时（秒）、每模型最大重试次数、退避基数（指数退避+抖动）
llm_timeout_seconds=30
llm_max_retries=2
llm_backoff_base_seconds=0.5
# 降级模型链（逗号分隔按序尝试）：主模型重试耗尽后依次降级；留空表示不降级
llm_fallback_models=qwen-turbo
