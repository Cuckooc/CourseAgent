# MySQL 数据库配置
host=localhost
user=root
password=your_mysql_password
database=db_course
charset=utf8mb4
port=3306

# 应用配置
app_env=dev
# JWT 密钥：生产环境必须改为随机长字符串（如 python -c "import secrets;print(secrets.token_hex(32))"）
jwt_secret=dev-only-secret-change-me
jwt_algorithm=HS256
# access token 有效期（分钟），默认 12 小时
access_token_expire_minutes=720
# CORS 允许来源，多个用逗号分隔，生产环境配置具体域名白名单
cors_origins=*
# 文件上传
upload_max_mb=50
# 上传文件存储目录（相对项目根或绝对路径），与源码目录隔离
upload_dir=uploads
upload_allowed_ext=.pdf,.txt,.md
# Redis（可选）：多副本部署时必须配置（限流/验证码共享状态），单机开发可留空走内存实现
# redis_url=redis://localhost:6379/0

# 可观测性
# 日志级别：DEBUG/INFO/WARNING
# log_level=INFO
# 日志格式：auto=prod 用 JSON、dev 用彩色文本；可强制 true/false
# log_json=auto
# Prometheus 指标端点 /metrics（true 开启）
# metrics_enabled=true
